+// --- click-to-tune (LOCAL MOD): click a channel row to tune the CRT ---
+(function(){
+  function wire(){
+    var col=document.getElementById('stations-column');
+    if(!col){ setTimeout(wire,500); return; }
+    if(col._tuneWired) return; col._tuneWired=true;
+    col.addEventListener('click', function(e){
+      var row=e.target.closest('.station-row[data-channel]');
+      if(!row) return;
+      var ch=parseInt(row.dataset.channel,10);
+      if(isNaN(ch)) return;
+      row.classList.add('tuned-flash');
+      setTimeout(function(){ row.classList.remove('tuned-flash'); },700);
+      try{ var r=window.fs42Api.get('player/channels/'+ch); if(r&&r.catch){ r.catch(function(err){ console.error('tune failed',ch,err); }); } }
+      catch(err){ console.error('tune failed',ch,err); }
+    });
+  }
+  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',wire); } else { wire(); }
+})();
+
+
+// --- click-to-tune on the program grid too (LOCAL MOD) ---
+(function(){
+  function wireGrid(){
+    var grid=document.getElementById('guide-grid');
+    if(!grid){ setTimeout(wireGrid,500); return; }
+    if(grid._tuneWired) return; grid._tuneWired=true;
+    grid.addEventListener('click', function(e){
+      var row=e.target.closest('.guide-row[data-channel]');
+      if(!row) return;
+      var ch=parseInt(row.dataset.channel,10);
+      if(isNaN(ch)) return;
+      try{ var r=window.fs42Api.get('player/channels/'+ch); if(r&&r.catch){ r.catch(function(err){console.error('tune failed',ch,err);}); } }
+      catch(err){ console.error('tune failed',ch,err); }
+    });
+  }
+  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',wireGrid); } else { wireGrid(); }
+})();
+
+
+// --- mouse-wheel manual scroll (LOCAL MOD) ---
+(function(){
+  function wireWheel(){
+    var sc=document.getElementById('stations-column');
+    var gc=document.querySelector('.guide-grid-container');
+    if(!sc || !gc){ setTimeout(wireWheel,500); return; }
+    if(window._wheelWired) return; window._wheelWired=true;
+    document.body.addEventListener('wheel', function(e){
+      window._userScroll = Date.now();
+      var max = sc.scrollHeight - sc.clientHeight;
+      var nx = Math.max(0, Math.min(max, sc.scrollTop + e.deltaY));
+      sc.scrollTop = nx; gc.scrollTop = nx;
+      e.preventDefault();
+    }, {passive:false});
+  }
+  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',wireWheel); } else { wireWheel(); }
+})();
